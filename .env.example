# ============================================================
# BHOO RAKSHA – Environment Variables Template
# ============================================================

# ------------------------------------------------------------
# 1. SECURITY & RUNTIME MODE
# ------------------------------------------------------------
DEMO_MODE=false
DEMO_OTP_ENABLED=false
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production-min-32-chars!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# ------------------------------------------------------------
# 2. DATABASE
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bhooraksha
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ------------------------------------------------------------
# 3. REDIS (Cache & Session)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_SSL=false
REDIS_CACHE_TTL=3600

# ------------------------------------------------------------
# 4. RABBITMQ (Event Bus)
# ------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_DEFAULT_QUEUE=bhooraksha_events

# ------------------------------------------------------------
# 5. MINIO (Document Storage)
# ------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=bhooraksha-documents
MINIO_BUCKET_VERIFIED=bhooraksha-verified

# ------------------------------------------------------------
# 6. AUTH SERVICE
# ------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8000
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ------------------------------------------------------------
# 7. AI AGENT ORCHESTRATOR
# ------------------------------------------------------------
AI_ORCHESTRATOR_URL=http://localhost:8001
MODEL_PATH=/models
LLM_PROVIDER=gemini
GEMINI_API_KEY=mock-gemini-key
OPENAI_API_KEY=mock-openai-key
OCR_MODEL=chitrapathak-1
NER_MODEL=muril-address-ner

# ------------------------------------------------------------
# 8. GOVERNMENT API INTEGRATION
# ------------------------------------------------------------
GOVT_API_BASE_URL=http://localhost:8000/api/v1/mock-govt
GOVT_API_KEY=bhooraksha-govt-integration-key-2026
GOVT_API_TIMEOUT=10
GOVT_API_RETRY_ATTEMPTS=3
GOVT_API_RETRY_DELAY=2

# ------------------------------------------------------------
# 8.1 BHASHINI AI INTEGRATION (National Language Translation Mission)
# ------------------------------------------------------------
USE_BHASHINI=false
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ------------------------------------------------------------
# 9. GIS SERVICE
# ------------------------------------------------------------
GIS_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
GIS_CADASTRAL_DATA_PATH=./data/cadastral

# ------------------------------------------------------------
# 10. CELERY (Background Tasks)
# ------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------
# 11. LOGGING
# ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true

# ------------------------------------------------------------
# 12. CORS & ALLOWED ORIGINS
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:8080,http://localhost:80

# ------------------------------------------------------------
# 13. RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ------------------------------------------------------------
# 14. OAUTH / OIDC PROVIDERS
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/microsoft/callback

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/apple/callback

# ------------------------------------------------------------
# 15. EMAIL & SMS DISPATCH PROVIDERS
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bhooraksha.gov.in

SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=BHOORK

# ------------------------------------------------------------
# 16. FRONTEND (Vite)
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws
VITE_AUTH_SERVICE_URL=http://localhost:8080/api/v1/auth
